{
  "$schema": "https://unpkg.com/create-express-modular@latest/cem-cli.schema.json",
  "version": "3.3.8",
  "project": {
    "name": "food-canteen-server",
    "db": "mongoose",
    "validator": "zod",
    "auth": true,
    "authTokenDelivery": "header",
    "docker": true,
    "packageManager": "npm"
  },
  "structure": {
    "srcDir": "src",
    "appDir": "src/app",
    "modulesDir": "src/app/modules",
    "middlewaresDir": "src/app/middlewares",
    "utilsDir": "src/app/utils",
    "configDir": "src/app/config"
  },
  "features": {
    "testing": false,
    "websocket": false,
    "swagger": true
  }
}
